{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "SwagInference": {
    "MultipleChoice": {
      "MaxChoices": 4
    },
    "BatchExecutors": {
      "Parallel": {
        "MaxConcurrency": 4
      },
      "TokenCountSorting": {
        "Ascending": false
      },
      "MaxPaddedTokens": {
        "MaxPaddedTokenRatio": 0.1,
        "MaxTokenCount": 8192
      }
    }
  }
}
