{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "SentimentInference": {
    "Classification": {
      "Choices": [false, true]
    },
    "BatchExecutors": {
      "MaxPaddedTokens": {
        "MaxPaddedTokenRatio": 0.1,
        "MaxTokenCount": 2048
      },
      "TokenCountSorting": {
        "Ascending": true
      },
      "ParallelSchedular": {
        "MaxConcurrency": 10
      }
    }
  }
}
