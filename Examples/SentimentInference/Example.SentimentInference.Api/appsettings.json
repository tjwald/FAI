{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "SentimentInference": {
    "Classification": {
      "Choices": [false, true]
    },
    "BatchExecutors": {
      "MaxPaddedTokens": {
        "MaxPaddedRatio": 0.1,
        "MaxTokensCount": 2048
      }
    }
  },
  "AllowedHosts": "*"
}
